# ── Internal Infrastructure ────────────────────────────────────────────────────
ROBOT_CHECKER_URL=http://192.168.2.123:8015/checkRobot

# ── LLM Provider Selector ──────────────────────────────────────────────────────
# Options: "astra" | "naukri" | "gemini" | "groq"
LLM_PROVIDER=naukri

# ── Astra Gen-AI Real-Time Execution Service ────────────────────────────────────
SECRET_KEY=your_astra_secret_key_here
TEMPLATE_CODE=PE_GENERATE_CRAWL_CONFIG
APP_ID=123
SYSTEM_ID=123
GENAI_BASE_URL=http://services.test2.ff-services-test2.cluster.infoedge.com/prompt-execute-services/prompts

# ── Gemini / Groq / Naukri Gateway ─────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
NAUKRI_TOKEN=Bearer your_naukri_token_here
NAUKRI_API_URL=https://dashboard.naukri.com/gen-ai/prompt/chat
NAUKRI_MODEL=gpt-5.6-luna
NAUKRI_APP_ID=123
NAUKRI_SYSTEM_ID=123
NAUKRI_EMAIL=user@infoedge.com
